<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="timenotes.exe"
        Arguments=""
        InstallLocation="C:\Program Files\ALGFWQ\TimeNotes">
    </Installer>
    <PackageInformation
        PackageName="TimeNotes"
        PackageDisplayName="TimeNotes"
        PublisherName="CN=ALGFWQ"
        PublisherDisplayName="ALGFWQ"
        Version="0.1.0.0"
        PackageDescription="A TimeNotes application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.algfwq.timenotes"
                Description="A TimeNotes application"
                DisplayName="TimeNotes"
                ExecutableName="timenotes.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="zh-cn" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>TimeNotes</DisplayName>
            <PublisherDisplayName>ALGFWQ</PublisherDisplayName>
            <Description>A TimeNotes application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="timenotes.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
