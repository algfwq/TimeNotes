<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime - Required for macOS app distribution outside App Store -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Allow JIT for WebKit/WKWebView -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Allow dyld environment variables (WebKit plugin loading) -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<!-- Network access for collaboration features -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Microphone access for voice chat (collaboration mode) -->
	<key>com.apple.security.device.microphone</key>
	<true/>
	<!-- Camera access for video element support -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Apple Events for automation support -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Read/write access to user-selected files -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Read/write access to Downloads folder -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
