<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>TimeNotes</string>
	<key>CFBundleGetInfoString</key>
	<string>TimeNotes desktop hand-journal notebook</string>
	<key>CFBundleIconFile</key>
	<string>icons</string>
	<key>CFBundleIconName</key>
	<string>appicon</string>
	<key>CFBundleIdentifier</key>
	<string>com.algfwq.timenotes</string>
	<key>CFBundleName</key>
	<string>TimeNotes</string>
	<key>CFBundleDisplayName</key>
	<string>TimeNotes</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>2.0.0</string>
	<key>CFBundleVersion</key>
	<string>2.0.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>10.15.0</string>

	<!-- High-DPI / Retina support -->
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- Deep dark mode support (macOS 10.14+) -->
	<key>NSAppearanceName</key>
	<string>NSAppearanceNameAqua</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<true/>

	<!-- Local networking (development server connection) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- 联机协作需要 HTTP/WS 连接到任意地址的 TimeNotesServer -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<key>NSHumanReadableCopyright</key>
	<string>© 2026, ALGFWQ</string>

	<!-- Document type association for .tnote files -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>TimeNotes Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.algfwq.timenotes.tnote</string>
			</array>
			<key>NSDocumentClass</key>
			<string>TimeNotes Document</string>
			<key>LSTypeIsPackage</key>
			<false/>
		</dict>
	</array>

	<!-- UTI declaration for .tnote files -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.algfwq.timenotes.tnote</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tnote</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-timenotes</string>
			</dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>org.pkware.zip-archive</string>
			</array>
			<key>UTTypeDescription</key>
			<string>TimeNotes 手账文档</string>
			<key>UTTypeIconFile</key>
			<string>icons</string>
		</dict>
	</array>
</dict>
</plist>
